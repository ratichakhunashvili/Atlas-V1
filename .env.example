# Database (PostgreSQL). Drizzle Kit and the app both read this.
DATABASE_URL=postgresql://user:password@localhost:5432/atlas

# Auth.js / NextAuth. Generate with: npx auth secret
AUTH_SECRET=

# Mapbox. The browser token is public (restrict it to your domains in the
# Mapbox dashboard); the server token must never be exposed to the client.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SERVER_TOKEN=

# Used only by `npm run db:seed:admin -- <email>` to grant the admin role.
ADMIN_EMAIL=

# Which Atlas deployment this is: local | development | qa | staging | production.
# Read on the server for the guest test-entry bypass and development-only routes.
# Missing or unknown values fail closed (no bypass). NODE_ENV alone cannot tell
# staging from production, so this is separate.
ATLAS_DEPLOYMENT_ENV=

# Comma-separated account emails allowed to open a seeded test stay without a
# hotel QR. Honoured only when ATLAS_DEPLOYMENT_ENV is local/development/qa/staging.
ATLAS_TEST_ENTRY_ACCOUNTS=
